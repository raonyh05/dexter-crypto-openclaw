# LLM Credentials
# xAI is the default provider in this fork.
XAI_API_KEY=your-api-key

# OpenAI is optional.
# Official OpenAI API auth uses API keys. OPENAI_BEARER_TOKEN is only a generic
# bearer-token fallback for advanced/self-managed setups and is not guaranteed
# by OpenAI docs as a replacement for API keys.
OPENAI_API_KEY=your-api-key
OPENAI_BEARER_TOKEN=your-bearer-token
OPENAI_ACCESS_TOKEN=your-access-token

ANTHROPIC_API_KEY=your-api-key
GOOGLE_API_KEY=your-api-key
OPENROUTER_API_KEY=your-api-key
MOONSHOT_API_KEY=your-api-key
DEEPSEEK_API_KEY=your-api-key

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Persistent memory embeddings reuse supported embedding providers.
# Priority: OpenAI -> Gemini -> Ollama. If none are configured, memory falls
# back to keyword search only. xAI is not used for embeddings here.

# Stock Market API Key
FINANCIAL_DATASETS_API_KEY=your-api-key

# Optional crypto research API (read-only)
# Used for tokenomics, protocol metrics, on-chain activity, derivatives,
# governance, unlocks, treasury flows, and security incidents.
CRYPTO_RESEARCH_API_BASE_URL=https://your-crypto-data-provider.example.com
CRYPTO_RESEARCH_API_KEY=your-api-key
# Optional override if your provider uses a different auth header
CRYPTO_RESEARCH_API_KEY_HEADER=x-api-key

# Web Search API Keys (Exa → Perplexity → Tavily)
EXASEARCH_API_KEY=your-api-key
PERPLEXITY_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key

# X/Twitter API (enables x_search tool for public sentiment research)
X_BEARER_TOKEN=your-bearer-token

# LangSmith 
LANGSMITH_API_KEY=your-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=false
